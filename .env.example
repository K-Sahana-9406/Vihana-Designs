# ==============================================================================
# VIHANA DESIGNS — Environment Configuration Template
# Copy this file to .env for local testing or populate these variables in Vercel
# NEVER commit your real credentials to Git!
# ==============================================================================

# Database Connection (Automatically populated by Vercel Prisma Postgres Integration)
# Example: postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# Or Prisma Postgres connection string: prisma+postgres://accelerate.prisma-data.net/?api_key=...
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentication Security (Generate a 32+ character random string)
JWT_SECRET="generate_a_secure_random_jwt_secret_32_characters_minimum"

# Public Application URL (Update to your live Vercel domain once deployed)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ------------------------------------------------------------------------------
# Payment Gateway Configuration (Razorpay)
# Set PAYMENT_MODE="TEST" while setting up. Change to "LIVE" once verified.
# ------------------------------------------------------------------------------
PAYMENT_MODE="TEST"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# Email Service Configuration (Brevo / SMTP Relay)
# Brevo SMTP Settings: Host: smtp-relay.brevo.com, Port: 587
# ------------------------------------------------------------------------------
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login-email@example.com"
SMTP_PASS="your-brevo-smtp-key"
EMAIL_FROM="VIHANA DESIGNS <hello@vihanadesigns.com>"
CONTACT_EMAIL="hello@vihanadesigns.com"

# Admin Setup Key (Optional)
ADMIN_SECRET_KEY="optional_admin_setup_secret_key"
