DATABASE_URL="file:./dev.db" # Or postgresql://user:password@host:5432/db for PostgreSQL
JWT_SECRET="your-secure-random-jwt-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateway Configuration (Razorpay)
PAYMENT_MODE="TEST" # Switch to "LIVE" in production
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_..."

# Email Configuration
SMTP_HOST="smtp.provider.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="VIHANA DESIGNS <hello@vihanadesigns.com>"
CONTACT_EMAIL="hello@vihanadesigns.com"

